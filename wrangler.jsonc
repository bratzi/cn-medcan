{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cn-medcan",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cn-medcan-db",
			// Platzhalter: mit `npx wrangler d1 create cn-medcan-db` erzeugen und hier eintragen.
			// Lokale Entwicklung (`wrangler dev` / getPlatformProxy) braucht die echte ID nicht.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
