{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cn-medcan",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	}
	// Secrets werden NICHT hier gesetzt, sondern mit `wrangler secret put <NAME>`.
	// Lokal liegen sie in .dev.vars bzw. .env.local (beide gitignored).
	// Benoetigt: DATABASE_URL, DIRECT_URL, SITE_PASSWORD, SITE_SESSION_SECRET,
	//            NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
}
