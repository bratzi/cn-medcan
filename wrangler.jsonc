{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cn-medcan",
	// Eigener Einstieg, laedt den Next-Server schon beim Start des Isolats (worker.mjs).
	"main": "worker.mjs",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	},

	// Datenbank. D1 laeuft als Binding, es gibt keine Verbindungs-URL und kein
	// Passwort - deshalb steht hier auch nichts Geheimes.
	//
	// `database_id` ist die echte Datenbank in Cloudflare (angelegt am
	// 2026-09-23 mit `--jurisdiction eu`: Mitgliederdaten mit Gesundheitsbezug
	// bleiben in der EU). Sie gilt fuer `--remote` und `npm run deploy`.
	//
	// `preview_database_id` gilt fuer alles Lokale (`next dev`, `--local`,
	// `npm run preview`). Miniflare benennt die Datei unter .wrangler/ nach
	// einem Hash dieser ID. Der Wert ist der fruehere Platzhalter und bleibt
	// absichtlich stehen: aendert man ihn, zeigt die lokale Entwicklung auf
	// eine neue, leere Datei, und `npm run db:seed` findet zwei Dateien.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cn-medcan-db",
			"database_id": "cdee3489-a940-4353-b164-c58e7a1226f7",
			"preview_database_id": "PLATZHALTER-wrangler-d1-create-ausfuehren",
			"migrations_dir": "migrations"
		},
		// Tag-Cache fuer On-Demand-Revalidierung (Session 54): eine Bewertung baut
		// Startseite und /reviews gezielt neu, sonst nur einmal am Tag (spart CPU,
		// Free-Plan 10 ms je Anfrage). Eigene Datenbank, Tabelle aus db/tag-cache.sql.
		// Ohne "remote": true: das brach 2026-09-25 den Cloudflare-Build (8df8670).
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "cn-medcan-tags",
			"database_id": "c71695ff-7eee-4c05-af39-2f39f0865b60"
		}
	],

	// Cache fuer statische Seiten (ISR, Spec 2026-10-01): OpenNext legt gerenderte
	// Seiten in KV ab. Free-Plan: 1000 Schreibvorgaenge am Tag, hart begrenzt, keine
	// Kosten. Die ID ist kein Geheimnis. Angelegt per Cloudflare-API am 2026-10-01.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "501e88b46f8344ff85f88eb24dcea156"
		}
	],

	// Zeitbasierte Revalidierung: OpenNexts memoryQueue ruft den eigenen Worker
	// ueber dieses Service-Binding auf (Spec 2026-10-01, 4.4). Kostenlos.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cn-medcan"
		}
	]

	// Secrets werden NICHT hier gesetzt, sondern mit `wrangler secret put <NAME>`.
	// Lokal liegen sie in .dev.vars bzw. .env.local (beide gitignored).
	// Benoetigt: SITE_PASSWORD, FACHKREIS_PASSWORD, SITE_SESSION_SECRET
}
