# ============================================================================
#  cn-medcan - Zugangsdaten
#  ---------------------------------------------------------------------------
#  1. Diese Datei kopieren:  cp .env.local.example .env.local
#  2. In .env.local die Platzhalter ersetzen. NUR .env.local ausfuellen.
#  3. .env.local ist in .gitignore und landet nie im Repo. Diese Beispieldatei
#     wird committed - hier also NIE echte Werte eintragen.
#
#  Das Repo ist oeffentlich. Sollte ein Wert doch einmal committed werden,
#  reicht Loeschen nicht: der Wert muss rotiert werden, weil er ab dem Push
#  weltweit lesbar war.
# ============================================================================

# ---------------------------------------------------------------------------
#  1. Datenbank - Cloudflare D1
#
#     HIER IST NICHTS EINZUTRAGEN. D1 laeuft als Binding im Worker, ohne
#     Verbindungs-URL und ohne Passwort. Die Datenbank wird einmalig angelegt:
#
#       npx wrangler login
#       npx wrangler d1 create cn-medcan-db
#
#     Die ausgegebene database_id gehoert in wrangler.jsonc (nicht geheim,
#     wird mitcommittet). Lokal arbeitet wrangler gegen eine Datei unter
#     .wrangler/ - dafuer braucht es nicht einmal einen Cloudflare-Account.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
#  2. Zugangsschutz der Seite waehrend der Entwicklungsphase
# ---------------------------------------------------------------------------

# Passwort, mit dem du die Seite ueberhaupt aufmachst. Frei waehlbar.
SITE_PASSWORD="dein-wunschpasswort"

# Zweites, ANDERES Passwort. Wer es benutzt, kommt ebenfalls rein, bekommt
# zusaetzlich die Fachkreis-Rolle und sieht damit Apothekenpreise und
# Bestaende (Paragraph 10 HWG - siehe HANDOFF.md).
# Muss sich von SITE_PASSWORD unterscheiden, sonst waere die Rolle wirkungslos.
FACHKREIS_PASSWORD="dein-fachkreis-passwort"

# Signiert das Session-Cookie und die darin transportierte Rolle.
# NICHT identisch mit einem der beiden Passwoerter.
# Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_SESSION_SECRET="hier-32-byte-hex-einsetzen"

# ---------------------------------------------------------------------------
#  3. Instagram-Einbettung (optional, jederzeit nachtragbar)
#     Nur die oeffentliche Reel-URL, kein Token. Leer lassen ist erlaubt -
#     die Komponente zeigt dann einen Platzhalter.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_INSTAGRAM_REEL_URL=""

# ---------------------------------------------------------------------------
#  4. Cloudflare-Zugangsdaten - hier bewusst NICHTS.
#     Lokal und fuer Deployments: `npx wrangler login` (OAuth im Browser).
#     Ein API-Token brauchst du nur fuer GitHub Actions. Das gehoert dann in
#     die Repository-Secrets, nicht in diese Datei.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
#  5. Better Auth - Mitgliederanmeldung
# ---------------------------------------------------------------------------

# Signiert Sitzungen und verschluesselt Tokens. Mindestens 32 Zeichen.
# Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Fuer den Worker: `wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=

# Oeffentliche Basis-URL. Lokal optional (wird aus dem Request abgeleitet),
# in Produktion setzen, sonst zeigen Rueckleitungen auf den falschen Host.
# BETTER_AUTH_URL=https://example.workers.dev

# Medien-Pipeline (nur Entwicklungszeit, scripts/medien/). Kostenloser Key von
# https://www.pexels.com/api/. Landet nie im Worker und wird nicht als Secret
# hochgeladen. Pixabay ist als zweite Quelle vorgesehen, derzeit aber nicht
# angebunden.
PEXELS_API_KEY=
