# ============================================================================
#  cn-medcan - Zugangsdaten
#  ---------------------------------------------------------------------------
#  1. Diese Datei kopieren:  cp .env.local.example .env.local
#  2. In .env.local die Platzhalter ersetzen. NUR .env.local ausfuellen.
#  3. .env.local ist in .gitignore und landet nie im Repo. Diese Beispieldatei
#     wird committed - hier also NIE echte Werte eintragen.
#
#  Das Repo ist oeffentlich. Sollte ein Wert doch einmal committed werden,
#  reicht Loeschen nicht: der Wert muss in Supabase bzw. Cloudflare rotiert
#  werden, weil er ab dem Push weltweit lesbar war.
# ============================================================================

# ---------------------------------------------------------------------------
#  1. Supabase - Projekt anlegen auf https://supabase.com (Free Tier)
#     Werte findest du unter: Project Settings -> API
# ---------------------------------------------------------------------------

# Oeffentlich, landet im Browser-Bundle. Unkritisch.
NEXT_PUBLIC_SUPABASE_URL="https://DEIN-PROJEKT-REF.supabase.co"

# Oeffentlich, landet im Browser-Bundle. Unkritisch, weil RLS dahinter schuetzt.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ---------------------------------------------------------------------------
#  2. Datenbank - Project Settings -> Database -> Connection string
#
#     WICHTIG, das ist die haeufigste Fehlerquelle:
#     DATABASE_URL  = Transaction Pooler, Port 6543  (Laufzeit / Workers)
#     DIRECT_URL    = Direct connection, Port 5432   (Prisma-Migrationen)
#
#     Enthalten das Datenbank-Passwort. Streng geheim.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.DEIN-PROJEKT-REF:DEIN-DB-PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.DEIN-PROJEKT-REF:DEIN-DB-PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
#  3. Zugangsschutz der Seite waehrend der Entwicklung
# ---------------------------------------------------------------------------

# Das Passwort, mit dem du die Seite aufmachst. Frei waehlbar.
SITE_PASSWORD="dein-wunschpasswort"

# Signiert das Session-Cookie. NICHT dasselbe wie SITE_PASSWORD.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_SESSION_SECRET="hier-32-byte-hex-einsetzen"

# ---------------------------------------------------------------------------
#  4. Instagram-Einbettung (optional, kann spaeter nachgetragen werden)
#     Nur die oeffentliche Reel-URL, kein Token.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_INSTAGRAM_REEL_URL=""

# ---------------------------------------------------------------------------
#  5. Cloudflare - wird NICHT hier eingetragen.
#     Deployment laeuft ueber `wrangler login` im Browser (OAuth).
#     Ein API-Token brauchst du nur fuer CI. Dann gehoert es in die
#     GitHub-Repository-Secrets, nicht in diese Datei.
# ---------------------------------------------------------------------------
