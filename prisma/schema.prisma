// Medizinalcannabis-Katalog - deutscher Markt
// Datenbank: Cloudflare D1 (SQLite). Zugriff ausschliesslich ueber das
// Worker-Binding DB, siehe lib/prisma.ts.

// runtime = "cloudflare" ist Pflicht: ohne die Angabe erzeugt Prisma den
// Query-Compiler als Base64-Text und kompiliert ihn zur Laufzeit mit
// `new WebAssembly.Module()`. Workers verbieten das ("Wasm code generation
// disallowed by embedder") - live warf damit jede Datenbankabfrage. Mit
// "cloudflare" wird die .wasm-Datei direkt importiert und von wrangler beim
// Upload vorkompiliert. Lokal in `next dev` fiel das nie auf (Node erlaubt es).
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "cloudflare"
}

// Nur fuer prisma/seed.ts, das mit tsx unter reinem Node laeuft. Dort liefert
// der `.wasm?module`-Import des Cloudflare-Clients nichts ("The loaded wasm
// module was unexpectedly undefined"). `next dev` braucht diesen Client nicht,
// Turbopack versteht den Import. Gleiches Schema, also gleiche Typen.
generator seed {
  provider = "prisma-client"
  output   = "../lib/generated/prisma-node"
  runtime  = "nodejs"
}

// D1 hat keine Verbindungs-URL. Migrationen laufen hybrid:
//   wrangler d1 migrations create cn-medcan-db <name>
//   prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script
//   wrangler d1 migrations apply cn-medcan-db --local   (bzw. --remote)
// Siehe db/README.md.
datasource db {
  provider = "sqlite"
}

// Enums gibt es in SQLite nicht. Die sieben Wertelisten stehen als
// TS-Unions in db/enums.ts; in der Datenbank sind es String-Spalten, die
// von den CHECK-Constraints in db/constraints.sql abgesichert werden.

// ---------------------------------------------------------------------------
//  Stammdaten
// ---------------------------------------------------------------------------

/// Hersteller und Importeur. Im deutschen Markt haeufig getrennte Firmen,
/// gelegentlich identisch - deshalb eine Entitaet mit Rolle.
model Unternehmen {
  id        String  @id @default(uuid())
  name      String
  land      String?
  rolle     String
  gdpNummer String? @map("gdp_nummer")
  website   String?

  hergestellt Strain[] @relation("Hersteller")
  importiert  Strain[] @relation("Importeur")

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@unique([name, rolle])
  @@map("unternehmen")
}

model Terpen {
  id          String @id @default(uuid())
  name        String @unique
  aromaProfil String @map("aroma_profil")
  /// Ordnet das Terpen einer Geschmacksachse zu - Basis fuer den Filter
  /// "dominanter Geschmack" und fuer die Terpen-Map.
  geschmack   String
  siedepunktC Float? @map("siedepunkt_c")

  strains StrainTerpen[]

  @@map("terpene")
}

/// Ein Produkt im Sinne des BfArM-Handelsnamens.
model Strain {
  id                      String  @id @default(uuid())
  slug                    String  @unique
  /// Handelsname laut BfArM - die verbindliche Produktbezeichnung.
  handelsname             String  @unique
  pzn                     String?
  darreichungsform        String  @default("BLUETE")
  kultivarName            String? @map("kultivar_name")
  kultivarTyp             String  @map("kultivar_typ")
  /// Kreuzung, z. B. Sour Diesel x OG Kush.
  genetik                 String?
  thcMinProzent           Float   @map("thc_min_prozent")
  thcMaxProzent           Float   @map("thc_max_prozent")
  cbdMinProzent           Float   @map("cbd_min_prozent")
  cbdMaxProzent           Float   @map("cbd_max_prozent")
  bestrahlung             String  @default("UNBEKANNT")
  anbauland               String?
  /// Pfad zum Produktbild des Herstellers (unter /public oder R2).
  herstellerBildPfad      String? @map("hersteller_bild_pfad")
  beschreibung            String?
  verschreibungspflichtig Boolean @default(true)
  bfarmGelistet           Boolean @default(true) @map("bfarm_gelistet")
  aktiv                   Boolean @default(true)
  /// Kleingeschriebene Kopie der durchsuchbaren Felder (Handelsname,
  /// Kultivarname, Genetik). SQLite kann `contains` nicht
  /// case-insensitive - Prisma bildet `mode: "insensitive"` dort nicht ab.
  /// Deshalb wird beim Schreiben kleingeschrieben gefuellt und die
  /// Sucheingabe ebenfalls kleingeschrieben verglichen.
  suchtext                String

  herstellerId String?      @map("hersteller_id")
  hersteller   Unternehmen? @relation("Hersteller", fields: [herstellerId], references: [id], onDelete: SetNull)
  importeurId  String?      @map("importeur_id")
  importeur    Unternehmen? @relation("Importeur", fields: [importeurId], references: [id], onDelete: SetNull)

  terpene   StrainTerpen[]
  bestaende PharmacyStock[]
  chargen   Charge[]
  reviews   Review[]

  umfrageVorschlaege UmfrageVorschlag[]
  umfrageOptionen    UmfrageOption[]

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  @@index([kultivarTyp])
  @@index([thcMinProzent])
  @@index([darreichungsform])
  @@index([aktiv])
  @@index([suchtext])
  @@map("strains")
}

/// Terpenprofil je Produkt. rang = 1 ist das dominante Terpen.
model StrainTerpen {
  strainId             String @map("strain_id")
  strain               Strain @relation(fields: [strainId], references: [id], onDelete: Cascade)
  terpenId             String @map("terpen_id")
  terpen               Terpen @relation(fields: [terpenId], references: [id], onDelete: Cascade)
  konzentrationProzent Float? @map("konzentration_prozent")
  rang                 Int

  @@id([strainId, terpenId])
  @@unique([strainId, rang])
  @@index([terpenId])
  @@map("strain_terpene")
}

/// Deutsche Versandapotheke.
model Pharmacy {
  id                  String  @id @default(uuid())
  slug                String  @unique
  name                String
  plz                 String
  ort                 String
  strasse             String?
  telefon             String?
  email               String?
  website             String?
  versandapotheke     Boolean @default(true)
  /// Lieferzeit in Werktagen, als Spanne.
  lieferzeitTageMin   Int     @map("lieferzeit_tage_min")
  lieferzeitTageMax   Int     @map("lieferzeit_tage_max")
  rezeptStatus        String  @map("rezept_status")
  /// Nimmt die Apotheke den E-Rezept-Token per Upload oder App an?
  eRezeptTokenUpload  Boolean @default(false) @map("erezept_token_upload")
  betriebserlaubnisNr String? @map("betriebserlaubnis_nr")

  bestaende PharmacyStock[]

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  @@index([plz])
  @@map("pharmacies")
}

/// Bestandszuweisung Apotheke zu Produkt. Preise als Integer-Cent.
model PharmacyStock {
  id                String   @id @default(uuid())
  pharmacyId        String   @map("pharmacy_id")
  pharmacy          Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  strainId          String   @map("strain_id")
  strain            Strain   @relation(fields: [strainId], references: [id], onDelete: Cascade)
  packungGramm      Int      @map("packung_gramm")
  preisProGrammCent Int?     @map("preis_pro_gramm_cent")
  bestandGramm      Float?   @map("bestand_gramm")
  status            String   @default("VERFUEGBAR")
  /// Preise verschreibungspflichtiger Arzneimittel unterliegen dem HWG.
  /// Steuert das Fachkreis-Gate in der Oberflaeche.
  nurFuerFachkreise Boolean  @default(true) @map("nur_fuer_fachkreise")
  standAm           DateTime @default(now()) @map("stand_am")

  @@unique([pharmacyId, strainId, packungGramm])
  @@index([strainId, status])
  @@index([preisProGrammCent])
  @@map("pharmacy_stock")
}

/// Charge / Batch. Bewertungen haengen an der Charge, nicht nur am Produkt -
/// zwei Chargen desselben Handelsnamens koennen deutlich abweichen.
model Charge {
  id            String    @id @default(uuid())
  strainId      String    @map("strain_id")
  strain        Strain    @relation(fields: [strainId], references: [id], onDelete: Cascade)
  chargenNr     String    @map("chargen_nr")
  analysedatum  DateTime?
  thcIst        Float?    @map("thc_ist")
  cbdIst        Float?    @map("cbd_ist")
  laborBericht  String?   @map("labor_bericht")
  verfallsdatum DateTime?

  reviews Review[]

  @@unique([strainId, chargenNr])
  @@map("chargen")
}

// ---------------------------------------------------------------------------
//  Community
// ---------------------------------------------------------------------------

/// Bewertung nach festem Schema, gebunden an eine konkrete Charge.
model Review {
  id       String  @id @default(uuid())
  strainId String  @map("strain_id")
  strain   Strain  @relation(fields: [strainId], references: [id], onDelete: Cascade)
  chargeId String? @map("charge_id")
  charge   Charge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  /// Autor der Bewertung.
  ///
  /// Bewusst optional: die fiktiven Bewertungen aus dem Seed haben kein
  /// Mitglied hinter sich, und ein geloeschtes Mitglied soll seine Bewertung
  /// nicht mitnehmen (`SetNull` statt `Cascade`). Wer schreiben darf,
  /// entscheidet die Schreibschicht, nicht die Spalte.
  autorId String?   @map("autor_id")
  autor   Mitglied? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  /// Trennt die Bewertungen des Betreibers von Community-Bewertungen. Die
  /// redaktionellen sind der zentrale Anhaltspunkt der Seite; Community-
  /// Bewertungen stehen als Zweitstimme darunter, nicht gleichrangig.
  istRedaktionell Boolean @default(false) @map("ist_redaktionell")

  /// Festes Bewertungsschema, jeweils 1-5.
  aussehen   Int
  geruch     Int
  geschmack  Int
  wirkung    Int
  konsistenz Int

  /// Restfeuchte in Prozent. Unter 8 Prozent zu trocken, ueber 13 Prozent
  /// Schimmelrisiko - deshalb als eigener Messwert, nicht als Note.
  feuchtigkeitProzent Float? @map("feuchtigkeit_prozent")

  /// Geschmacks-Matrix: Achse zu Intensitaet 0-5, als JSON-Text.
  /// SQLite hat keinen JSON-Typ; gelesen wird sie ueber
  /// parseGeschmacksMatrix() in lib/query/bewertung.ts, die den Text parst
  /// und validiert. Niemals ungeprueft JSON.parse in einer Komponente.
  geschmacksMatrix String @map("geschmacks_matrix")

  /// Terpen-Intensitaet (Spec Redesign 15): Terpenname zu 1-5, als JSON-Text.
  /// 1 zu schwach, 3 Sweet Spot, 5 zu stark. Gelesen ueber
  /// parseTerpenIntensitaet() in lib/query/bewertung.ts.
  terpenIntensitaet String? @map("terpen_intensitaet")

  notiz String?

  /// Oeffentliche Instagram-Reel-URL zur Bewertung.
  instagramReelUrl String? @map("instagram_reel_url")

  /// Freigabe, bevor die Bewertung oeffentlich sichtbar ist.
  freigegeben Boolean @default(false)

  erstelltAm     DateTime @default(now()) @map("erstellt_am")
  aktualisiertAm DateTime @updatedAt @map("aktualisiert_am")

  /// Ergebnis-Reviews einer Umfragerunde. Eine Bewertung kann aus mehreren
  /// Runden folgen (dieselbe Sorte gewinnt erneut), deshalb eine Liste.
  umfrageOptionen UmfrageOption[]

  @@index([strainId, freigegeben])
  @@index([chargeId])
  @@index([autorId])
  @@index([istRedaktionell, erstelltAm])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
//  Mitglieder und Anmeldung (Better Auth)
// ---------------------------------------------------------------------------
//
// Die vier Tabellen `user`, `session`, `account` und `verification` gehoeren
// Better Auth. Ihre Feldnamen sind VORGEGEBEN und stehen bewusst in
// camelCase ohne @map - Better Auth spricht die Spalten genau so an. Wer hier
// umbenennt, bricht die Anmeldung, ohne dass ein Typfehler darauf hinweist.
// Abgeglichen mit getAuthTables() aus better-auth@1.7.5.
//
// Eigene Felder stehen deshalb NICHT in `user`, sondern in `mitglied` mit 1:1
// darauf - so fasst ein Better-Auth-Update unsere Spalten nicht an.
//
// Zugriff laeuft ueber den Prisma-Adapter mit `transaction: false`: D1 hat
// keine Transaktionen, siehe db/README.md.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  mitglied Mitglied?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Passwort-Hash (scrypt). Steht bei Better Auth im Konto, nicht am Nutzer.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Die fachliche Seite eines Nutzers: alles, was dieses Projekt braucht und
/// Better Auth nicht kennt.
model Mitglied {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  anzeigename     String
  instagramHandle String? @map("instagram_handle")

  /// Manuelle Verifizierung durch den Betreiber. Erst damit besteht
  /// Stimmrecht in Umfragen und Sicht auf Preise. Registrierung ist offen -
  /// die Freigabe ist der Filter, nicht die Anmeldung.
  freigegeben    Boolean   @default(false)
  freigegebenAm  DateTime? @map("freigegeben_am")
  /// Mitglied-Id des Betreibers, der freigegeben hat. Absichtlich ohne
  /// Relation: eine Selbstrelation waere hier nur Ballast, die Spur reicht.
  freigegebenVon String?   @map("freigegeben_von")

  /// Werte nach MITGLIED_ROLLEN in db/enums.ts, geprueft in
  /// db/constraints.sql. `fachkreis` bleibt erhalten, damit die strengere
  /// Preis-Sichtbarkeit nach §10 HWG ohne Schemaaenderung nachziehbar ist.
  rolle String @default("MITGLIED")

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  vorschlaege UmfrageVorschlag[]
  stimmen     Stimme[]
  reviews     Review[]

  @@index([freigegeben])
  @@map("mitglied")
}

// ---------------------------------------------------------------------------
//  Umfragen - der Produktkern
// ---------------------------------------------------------------------------
//
// Eine Runde ergibt 3 bis 4 getestete Sorten:
//   1-2 GESETZTE Plaetze  - der Betreiber waehlt sie selbst, keine Abstimmung.
//   2 COMMUNITY-Plaetze   - darueber entscheiden die Stimmen der Mitglieder.
// Jedes freigegebene Mitglied hat GENAU EINE Stimme; die `communityPlaetze`
// stimmenstaerksten COMMUNITY-Optionen gewinnen.
//
// D1 hat keine Transaktionen. Eindeutigkeit steht deshalb durchgehend in
// Unique-Indizes, nie in einem "erst pruefen, dann schreiben" der
// Schreibschicht - das waere eine Race Condition.

/// Eine Umfragerunde.
model Umfrage {
  id           String  @id @default(uuid())
  titel        String
  beschreibung String?

  /// Werte nach UMFRAGE_PHASEN in db/enums.ts, geprueft in db/constraints.sql.
  phase String @default("VORSCHLAG")

  /// Sicherung "genau eine aktive Umfrage".
  ///
  /// SQLite kennt keine partiellen Unique-Indizes ueber Prisma, erlaubt aber
  /// beliebig viele NULL in einer Unique-Spalte. Deshalb traegt eine laufende
  /// Umfrage hier die Konstante 'AKTIV' und eine beendete NULL: ein zweiter
  /// 'AKTIV'-Satz wird von der Datenbank abgewiesen. Dass der Wert zur Phase
  /// passt, sichert ein Trigger in db/constraints.sql - nicht die Anwendung.
  aktiv String? @unique

  startAm        DateTime  @default(now()) @map("start_am")
  /// Ende der Vorschlagsphase. Rein informativ fuer die Oberflaeche - die
  /// Phase schaltet der Betreiber, nicht die Uhr (es gibt keinen Cron).
  vorschlagBisAm DateTime? @map("vorschlag_bis_am")
  endetAm        DateTime? @map("endet_am")

  /// Wie viele Plaetze die Abstimmung vergibt. Die gesetzten Plaetze zaehlen
  /// hier NICHT mit.
  communityPlaetze Int @default(2) @map("community_plaetze")

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  vorschlaege UmfrageVorschlag[]
  optionen    UmfrageOption[]
  stimmen     Stimme[]

  @@index([phase])
  @@map("umfragen")
}

/// Vorschlag eines Mitglieds in der Phase VORSCHLAG.
model UmfrageVorschlag {
  id        String  @id @default(uuid())
  umfrageId String  @map("umfrage_id")
  umfrage   Umfrage @relation(fields: [umfrageId], references: [id], onDelete: Cascade)
  strainId  String  @map("strain_id")
  strain    Strain  @relation(fields: [strainId], references: [id], onDelete: Cascade)

  /// Wer vorgeschlagen hat. Cascade: verschwindet das Mitglied, verschwindet
  /// sein Vorschlag - anders als bei einer Bewertung ist er ohne Autor wertlos.
  mitgliedId String   @map("mitglied_id")
  mitglied   Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade)

  begruendung String?

  /// Vom Betreiber als Kandidat uebernommen. Der Vorschlag bleibt erhalten,
  /// damit nachvollziehbar ist, von wem die Sorte kam.
  uebernommen Boolean @default(false)

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  /// Ein Mitglied schlaegt dieselbe Sorte in derselben Runde nur einmal vor.
  @@unique([umfrageId, mitgliedId, strainId])
  @@index([umfrageId, uebernommen])
  @@index([strainId])
  @@index([mitgliedId])
  @@map("umfrage_vorschlaege")
}

/// Ein Kandidat einer Runde - gesetzt oder aus einem Vorschlag uebernommen.
model UmfrageOption {
  id        String  @id @default(uuid())
  umfrageId String  @map("umfrage_id")
  umfrage   Umfrage @relation(fields: [umfrageId], references: [id], onDelete: Cascade)
  strainId  String  @map("strain_id")
  strain    Strain  @relation(fields: [strainId], references: [id], onDelete: Cascade)

  /// Anzeigereihenfolge. Eindeutig je Runde, damit die Liste stabil steht.
  reihenfolge Int

  /// Werte nach OPTION_HERKUNFT in db/enums.ts. GESETZT ist nicht abstimmbar -
  /// die Schreibschicht muss das pruefen, sonst liesse sich auf einen
  /// gesetzten Platz abstimmen.
  herkunft String

  /// Wird beim Beenden gesetzt: alle GESETZTEN plus die `communityPlaetze`
  /// stimmenstaerksten COMMUNITY-Optionen.
  istGewinner Boolean @default(false) @map("ist_gewinner")

  /// Die Bewertung, die aus diesem Platz entstanden ist.
  ergebnisReviewId String? @map("ergebnis_review_id")
  ergebnisReview   Review? @relation(fields: [ergebnisReviewId], references: [id], onDelete: SetNull)

  erstelltAm DateTime @default(now()) @map("erstellt_am")

  stimmen Stimme[]

  @@unique([umfrageId, strainId])
  @@unique([umfrageId, reihenfolge])
  @@index([umfrageId, herkunft])
  @@index([strainId])
  @@index([ergebnisReviewId])
  @@map("umfrage_optionen")
}

/// Die eine Stimme eines Mitglieds in einer Runde.
model Stimme {
  id        String  @id @default(uuid())
  umfrageId String  @map("umfrage_id")
  umfrage   Umfrage @relation(fields: [umfrageId], references: [id], onDelete: Cascade)

  optionId String        @map("option_id")
  option   UmfrageOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  mitgliedId String   @map("mitglied_id")
  mitglied   Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade)

  abgegebenAm DateTime @default(now()) @map("abgegeben_am")

  /// DIE Absicherung gegen Doppelstimmen. Genau eine Stimme je Mitglied und
  /// Runde - erzwungen von der Datenbank, nicht von einer Transaktion (die
  /// es auf D1 nicht gibt) und nicht von einer Pruefung vor dem Schreiben.
  @@unique([umfrageId, mitgliedId])
  @@index([optionId])
  @@map("stimmen")
}
